<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="1-aplicacao-criacao" author="sistema">
        <createTable tableName="aplicacao">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_aplicacao" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_aplicacao_slug"/>
            </column>
            <column name="tipo" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="TEXT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="data_criacao" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE aplicacao ADD CONSTRAINT ck_aplicacao_tipo CHECK (tipo IN ('PUBLICO', 'CONFIDENCIAL'));
            ALTER TABLE aplicacao ADD CONSTRAINT ck_aplicacao_status CHECK (status IN ('ATIVO', 'INATIVO'));
        </sql>
        <rollback>
            <dropTable tableName="aplicacao"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
