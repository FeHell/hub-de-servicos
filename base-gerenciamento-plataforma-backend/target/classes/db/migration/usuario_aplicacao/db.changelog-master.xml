<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="1-usuario-aplicacao-vinculo" author="sistema">
        <createTable tableName="usuario_aplicacao">
            <column name="id_usuario" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="id_aplicacao" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="usuario_aplicacao" columnNames="id_usuario, id_aplicacao" constraintName="pk_usuario_aplicacao"/>
        <addForeignKeyConstraint constraintName="fk_usuario_aplicacao_usuario"
                                 baseTableName="usuario_aplicacao" baseColumnNames="id_usuario"
                                 referencedTableName="usuario" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <addForeignKeyConstraint constraintName="fk_usuario_aplicacao_aplicacao"
                                 baseTableName="usuario_aplicacao" baseColumnNames="id_aplicacao"
                                 referencedTableName="aplicacao" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <createIndex tableName="usuario_aplicacao" indexName="idx_usuario_aplicacao_aplicacao">
            <column name="id_aplicacao"/>
        </createIndex>
    </changeSet>

    <changeSet id="2-usuario-aplicacao-ativo" author="sistema">
        <addColumn tableName="usuario_aplicacao">
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
