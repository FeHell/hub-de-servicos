<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="1-sessoes-criacao" author="sistema">
        <createTable tableName="sessoes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_sessoes" nullable="false"/>
            </column>
            <column name="id_usuario" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="id_aplicacao" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="id_familia" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_sessao_familia"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="expiracao_absoluta" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="expiracao_inatividade" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="data_ultima_utilizacao" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="data_revogacao" type="TIMESTAMPTZ"/>
            <column name="data_criacao" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="sessoes" columnNames="id, id_familia"
                             constraintName="uk_sessao_identificacao"/>
        <addForeignKeyConstraint constraintName="fk_sessao_usuario_aplicacao"
                                 baseTableName="sessoes" baseColumnNames="id_usuario, id_aplicacao"
                                 referencedTableName="usuario_aplicacao" referencedColumnNames="id_usuario, id_aplicacao"
                                 onDelete="RESTRICT"/>
        <createIndex tableName="sessoes" indexName="idx_sessao_usuario_aplicacao">
            <column name="id_usuario"/>
            <column name="id_aplicacao"/>
        </createIndex>
        <createIndex tableName="sessoes" indexName="idx_sessao_aplicacao">
            <column name="id_aplicacao"/>
        </createIndex>
        <sql>
            ALTER TABLE sessoes ADD CONSTRAINT ck_sessoes_status CHECK (status IN ('ATIVO', 'EXPIRADO', 'REVOGADO'));
        </sql>
        <rollback>
            <dropTable tableName="sessoes"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
