<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="1-aplicacao-permissao-vinculo" author="sistema">
        <createTable tableName="aplicacao_permissao">
            <column name="id_aplicacao" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="id_permissao" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="aplicacao_permissao" columnNames="id_aplicacao, id_permissao" constraintName="pk_aplicacao_permissao"/>
        <addForeignKeyConstraint constraintName="fk_aplicacao_permissao_aplicacao"
                                 baseTableName="aplicacao_permissao" baseColumnNames="id_aplicacao"
                                 referencedTableName="aplicacao" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <addForeignKeyConstraint constraintName="fk_aplicacao_permissao_permissao"
                                 baseTableName="aplicacao_permissao" baseColumnNames="id_permissao"
                                 referencedTableName="permissao" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <createIndex tableName="aplicacao_permissao" indexName="idx_aplicacao_permissao_permissao">
            <column name="id_permissao"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
