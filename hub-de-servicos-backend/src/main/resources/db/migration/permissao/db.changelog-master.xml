<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <changeSet id="1-permissao-criacao" author="sistema">
        <createTable tableName="permissao">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_permissao" nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_permissao_codigo"/>
            </column>
            <column name="descricao" type="TEXT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE permissao ADD CONSTRAINT ck_permissao_status CHECK (status IN ('ATIVO', 'INATIVO'));
        </sql>
        <rollback>
            <dropTable tableName="permissao"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
